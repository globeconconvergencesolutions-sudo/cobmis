# Copy to .env and fill in. .env is gitignored; never commit secrets.

# --- Hardware profile (small | medium | large), see config.yaml ---
COB_PROFILE=small
# Optional per-value overrides of the profile:
# COB_CHAT_MODEL=
# COB_SQL_MODEL=
# COB_EMBED_MODEL=
# COB_EMBED_DIM=
# COB_NUM_CTX=

# --- Ollama (must be loopback) ---
OLLAMA_HOST=127.0.0.1
COB_OLLAMA_URL=http://127.0.0.1:11434
COB_OLLAMA_TIMEOUT_S=300

# --- Postgres (docker compose) ---
POSTGRES_DB=cob
POSTGRES_PORT=5433
POSTGRES_SUPERUSER=cob_owner
POSTGRES_SUPERUSER_PASSWORD=change-me-owner
COB_APP_PASSWORD=change-me-app
COB_INGEST_PASSWORD=change-me-ingest
COB_READONLY_PASSWORD=change-me-readonly

# --- API ---
COB_API_HOST=127.0.0.1
COB_API_PORT=8000

# --- Paths ---
COB_DATA_DIR=./data

# --- Telemetry opt-outs for dependencies (belt and braces; see DECISIONS.md) ---
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
ANONYMIZED_TELEMETRY=False

# Copy to .env and fill in. .env is gitignored; never commit secrets.

# --- Hardware profile (small | medium | large), see config.yaml ---
COB_PROFILE=small
# Model backend. Keep "ollama" (the real local models). "mock" is a deterministic stand-in
# used only in the cloud build sandbox, which has no Ollama; it never gives real answers.
COB_LLM_BACKEND=ollama
# Optional per-value overrides of the profile:
# COB_CHAT_MODEL=
# COB_SQL_MODEL=
# COB_EMBED_MODEL=
# COB_EMBED_DIM=
# COB_NUM_CTX=

# --- Ollama (must be loopback) ---
OLLAMA_HOST=127.0.0.1
COB_OLLAMA_URL=http://127.0.0.1:11434
# Per-call Ollama read timeout (seconds). Cancel aborts in-flight calls sooner.
COB_OLLAMA_TIMEOUT_S=120
COB_OLLAMA_REWRITE_TIMEOUT_S=45
COB_OLLAMA_EMBED_TIMEOUT_S=60

# --- Postgres (docker compose) ---
# POSTGRES_SUPERUSER_PASSWORD is fixed when the Docker volume is first created. The three
# COB_*_PASSWORD roles are created/updated by `python -m scripts.migrate` from these values.
POSTGRES_DB=cob
POSTGRES_PORT=5433
POSTGRES_SUPERUSER=cob_owner
POSTGRES_SUPERUSER_PASSWORD=change-me-owner
COB_APP_PASSWORD=change-me-app
COB_INGEST_PASSWORD=change-me-ingest
COB_READONLY_PASSWORD=change-me-readonly

# --- API ---
COB_API_HOST=127.0.0.1
COB_API_PORT=8000

# --- UI (Phase 6) ---
# After migrate: python -m scripts.seed_admin
# Default login: admin@local / change-me-admin  (change immediately on shared machines)
# Frontend: cd frontend && npm run dev  → http://127.0.0.1:3000

# --- Paths ---
COB_DATA_DIR=./data

# --- Telemetry opt-outs for dependencies (belt and braces; see DECISIONS.md) ---
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
ANONYMIZED_TELEMETRY=False
